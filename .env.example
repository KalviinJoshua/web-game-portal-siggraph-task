# Supabase (optional) — enables the GLOBAL leaderboard.
# Copy this file to `.env` and fill in your project's values.
# When these are absent, Nebula Runner automatically uses a LOCAL leaderboard.
#
# Vite only exposes variables prefixed with VITE_ to the client.
# The anon key is a *public* key by design, but still keep it out of git.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_LEADERBOARD_TABLE=nebula_scores
